# انسخ هذا الملف إلى .env.local وعبّئ القيم الفعلية. لا تضع أي قيم حقيقية هنا.

# Clerk (Auth & Multi-tenancy) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Database) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (AI Agent) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend (Outreach email sending) — https://resend.com/api-keys
RESEND_API_KEY=
# يجب أن يكون النطاق موثّقاً في Resend، أو استخدم onboarding@resend.dev للاختبار فقط
RESEND_FROM_EMAIL=onboarding@resend.dev

# Webhook (استقبال عملاء من مصدر خارجي عبر app/api/webhooks/lead)
# سر عشوائي طويل تولّده أنت (مثال: openssl rand -hex 32) وتضعه أيضاً في المصدر الخارجي كـ header باسم x-webhook-secret
WEBHOOK_SECRET=
# معرّف منظمة Clerk (org_...) التي سيتم إسناد العملاء الواردين من الويب هوك إليها افتراضياً
WEBHOOK_DEFAULT_ORG_ID=

# Twilio WhatsApp (تنبيهات فورية عند وصول عميل HOT أو إرسال الطيار الآلي) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# رقم Twilio WhatsApp المُرسِل، مثال Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# رقمك الشخصي الذي سيستقبل التنبيهات، بصيغة whatsapp:+212xxxxxxxxx
MY_WHATSAPP_NUMBER=

# رابط التطبيق العام (اختياري) — يُستخدم في رسائل واتساب وكود التضمين.
# إن تُرك فارغاً يُشتق تلقائياً من Host الطلب الحالي.
NEXT_PUBLIC_APP_URL=
