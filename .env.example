# انسخ هذا الملف إلى .env.local وعبّئ القيم الفعلية. لا تضع أي قيم حقيقية هنا.

# Clerk (Auth & Multi-tenancy) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Database) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (AI Agent) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend (Outreach email sending) — https://resend.com/api-keys
RESEND_API_KEY=
# يجب أن يكون النطاق موثّقاً في Resend، أو استخدم onboarding@resend.dev للاختبار فقط
RESEND_FROM_EMAIL=onboarding@resend.dev
